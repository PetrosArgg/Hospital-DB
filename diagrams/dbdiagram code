Table Staff {
  id int [pk, increment]
  amka char(11) [not null, unique]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  birth_date date [not null]
  email varchar(100) [not null]
  phone varchar(15) [not null]
  hire_date date [not null]
}

Table Doctor {
  staff_id int [pk]
  license_number varchar(20) [not null, unique]
  specialty varchar(50) [not null]
  rank varchar(30) [not null]
  supervisor_id int [null]
  image_id int [null]
}

Table Nurse {
  staff_id int [pk]
  rank varchar(30) [not null]
  dep_id int [not null]
}

Table Admin {
  staff_id int [pk]
  role varchar(50) [not null]
  office varchar(20) [not null]
  dep_id int [not null]
}

Table DoctorDepartment {
  doctor_id int [not null]
  dep_id int [not null]
  primary key (doctor_id, dep_id)
}

Table Department {
  id int [pk, increment]
  name varchar(50) [not null]
  description text [null]
  location varchar(50) [not null]
  director_id int [not null]
  image_id int [null]
}

Table Bed {
  bed_number int [not null]
  dep_id int [not null]
  type varchar(20) [not null]
  status varchar(20) [not null]
  primary key (bed_number, dep_id)
}

Table Shift {
  id int [pk, increment]
  name varchar(20) [not null]
  start_time time [not null]
  end_time time [not null]
}

Table ShiftSlot {
  id int [pk, increment]
  dep_id int [not null]
  shift_id int [not null]
  shift_date date [not null]
}

Table ShiftAssignment {
  staff_id int [not null]
  slot_id int [not null]
  primary key (staff_id, slot_id)
}

Table Patient {
  id int [pk, increment]
  amka char(11) [not null, unique]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  father_name varchar(50) [not null]
  birth_date date [not null]
  gender varchar(10) [not null]
  weight float [not null]
  height float [not null]
  address varchar(100) [not null]
  phone varchar(15) [not null]
  email varchar(100) [null]
  job varchar(20) [null]
  nationality varchar(20) [not null]
  insurance_provider varchar(50) [not null]
}

Table EmergencyContact {
  id int [pk, increment]
  patient_id int [not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  phone varchar(15) [not null]
  relationship varchar(20) [not null]
}

Table TriageEntry {
  id int [pk, increment]
  patient_id int [not null]
  nurse_id int [not null]
  arrival_time timestamp [not null]
  service_time timestamp [null]
  urgency_level int [not null]
  symptoms text [not null]
  referral_status varchar(20) [not null]
  hosp_id int [null]
}

Table ICD10_Ref {
  code varchar(10) [pk]
  description text [not null]
}

Table KEN_Ref {
  code varchar(10) [pk]
  base_cost decimal(10,2) [not null]
  mdn_days int [not null]
}

Table Hospitalization {
  id int [pk, increment]
  patient_id int [not null]
  bed_number int [not null]
  dep_id int [not null]
  entry_date date [not null]
  exit_date date [null]
  icd10_entry_code varchar(10) [not null]
  icd10_exit_code varchar(10) [null]
  ken_code varchar(10) [not null]
  total_cost decimal(10,2) [null]
}

Table LabExam {
  id int [pk, increment]
  hosp_id int [not null]
  doctor_id int [not null]
  code varchar(20) [not null]
  exam_date date [not null]
  result_text text [null]
  result_value decimal(10,2) [null]
  result_unit varchar(20) [null]
  cost decimal(10,2) [not null]
}

Table LabExam_Ref {
  code varchar(20) [pk]
  name varchar(100) [not null]
  type varchar(50) [not null]
}

Table MedicalAct {
  id int [pk, increment]
  hosp_id int [not null]
  act_code varchar(20) [not null]
  duration_minutes int [not null]
  cost decimal(10,2) [not null]
  main_surgeon_id int [not null]
  room_id int [not null]
  scheduled_time timestamp [not null]
}

Table MedicalAct_Ref {
  code varchar(20) [pk]
  name varchar(100) [not null]
  category varchar(50) [not null]
}

Table OperatingRoom {
  id int [pk, increment]
  name varchar(50) [not null]
  type varchar(30) [not null]
}

Table ActDoctor {
  act_id int [not null]
  doctor_id int [not null]
  primary key (act_id, doctor_id)
}

Table ActNurse {
  act_id int [not null]
  nurse_id int [not null]
  primary key (act_id, nurse_id)
}

Table Medication {
  id int [pk, increment]
  product_name varchar(100) [not null]
}

Table ActiveSubstance {
  id int [pk, increment]
  substance_name varchar(100) [not null]
}

Table MedicationSubstance {
  medication_id int [not null]
  substance_id int [not null]
  primary key (medication_id, substance_id)
}

Table Allergy {
  patient_id int [not null]
  substance_id int [not null]
  primary key (patient_id, substance_id)
}

Table Prescription {
  doctor_id int [not null]
  patient_id int [not null]
  medication_id int [not null]
  hosp_id int [not null]
  start_date date [not null]
  dosage varchar(50) [not null]
  frequency varchar(50) [not null]
  end_date date [null]
  primary key (doctor_id, patient_id, medication_id, start_date)
}

Table Rating {
  rating_id int [pk, increment]
  hosp_id int [not null, unique]
  nursing_care_quality int [not null]
  cleanliness int [not null]
  food int [not null]
  overall_experience int [not null]
}

Table DoctorRating {
  id int [pk, increment]
  hosp_id int [not null]
  doctor_id int [not null]
  medical_care_quality int [not null]
}

Table Image {
  image_id int [pk, increment]
  description text [not null]
  image_url varchar(255) [not null]
}

Ref: Doctor.staff_id - Staff.id
Ref: Nurse.staff_id - Staff.id
Ref: Admin.staff_id - Staff.id
Ref: Doctor.supervisor_id > Doctor.staff_id
Ref: Doctor.image_id > Image.image_id

Ref: Department.director_id > Doctor.staff_id
Ref: Bed.dep_id > Department.id
Ref: Nurse.dep_id > Department.id
Ref: Admin.dep_id > Department.id
Ref: Department.image_id > Image.image_id

Ref: DoctorDepartment.doctor_id > Doctor.staff_id
Ref: DoctorDepartment.dep_id > Department.id

Ref: ShiftSlot.dep_id > Department.id
Ref: ShiftSlot.shift_id > Shift.id
Ref: ShiftAssignment.staff_id > Staff.id
Ref: ShiftAssignment.slot_id > ShiftSlot.id

Ref: EmergencyContact.patient_id > Patient.id

Ref: TriageEntry.patient_id > Patient.id
Ref: TriageEntry.nurse_id > Nurse.staff_id
Ref: TriageEntry.hosp_id - Hospitalization.id
Ref: Hospitalization.patient_id > Patient.id
Ref: Hospitalization.(bed_number, dep_id) > Bed.(bed_number, dep_id)

Ref: Hospitalization.icd10_entry_code > ICD10_Ref.code
Ref: Hospitalization.icd10_exit_code > ICD10_Ref.code
Ref: Hospitalization.ken_code > KEN_Ref.code

Ref: LabExam.hosp_id > Hospitalization.id
Ref: LabExam.doctor_id > Doctor.staff_id

Ref: LabExam.code > LabExam_Ref.code

Ref: MedicalAct.hosp_id > Hospitalization.id
Ref: MedicalAct.main_surgeon_id > Doctor.staff_id
Ref: MedicalAct.room_id > OperatingRoom.id

Ref: MedicalAct.act_code > MedicalAct_Ref.code

Ref: ActDoctor.act_id > MedicalAct.id
Ref: ActDoctor.doctor_id > Doctor.staff_id
Ref: ActNurse.act_id > MedicalAct.id
Ref: ActNurse.nurse_id > Nurse.staff_id

Ref: MedicationSubstance.medication_id > Medication.id
Ref: MedicationSubstance.substance_id > ActiveSubstance.id

Ref: Allergy.patient_id > Patient.id
Ref: Allergy.substance_id > ActiveSubstance.id
Ref: Prescription.medication_id > Medication.id
Ref: Prescription.patient_id > Patient.id
Ref: Prescription.doctor_id > Doctor.staff_id
Ref: Prescription.hosp_id > Hospitalization.id

Ref: Rating.hosp_id - Hospitalization.id
Ref: DoctorRating.hosp_id > Hospitalization.id
Ref: DoctorRating.doctor_id > Doctor.staff_id

