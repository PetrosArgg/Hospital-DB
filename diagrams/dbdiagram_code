Table Staff {
  amka char(11) [pk]
  first_name varchar(50)
  last_name varchar(50)
  birth_date date
  email varchar(100)
  phone varchar(15)
  hire_date date
}

Table Doctor {
  amka char(11) [pk]
  license_number varchar(20) [unique]
  specialty varchar(50)
  rank varchar(30)
  supervisor_amka char(11) [null]
  image_id int [null]
}

Table Nurse {
  amka char(11) [pk]
  rank varchar(30)
  dep_id int [not null]
}

Table Admin {
  amka char(11) [pk]
  role varchar(50)
  office varchar(20)
  dep_id int [not null]
}

Table DoctorDepartment {
  doctor_amka char(11) [not null]
  dep_id int [not null]
  primary key (doctor_amka, dep_id)
}

Table Department {
  id int [pk, increment]
  name varchar(50)
  description text
  location varchar(50)
  director_amka char(11)
  image_id int [null]
}

Table Bed {
  bed_number int
  dep_id int
  type varchar(20)
  status varchar(20)
  primary key (bed_number, dep_id)
}

Table Shift {
  id int [pk]
  name varchar(20)
  start_time time
  end_time time
}

Table ShiftAssignment {
  staff_amka char(11)
  dep_id int
  shift_id int
  shift_date date
  primary key (staff_amka, shift_date, shift_id)
}

Table Patient {
  amka char(11) [pk]
  first_name varchar(50)
  last_name varchar(50)
  father_name varchar(50)
  birth_date date
  gender varchar(10)
  weight float
  height float
  address varchar(100)
  phone varchar(15)
  email varchar(100)
  job varchar(20)
  nationality varchar(20)
  insurance_provider varchar(50)
}

Table EmergencyContact {
  id int [pk, increment]
  patient_amka char(11) [not null]
  first_name varchar(50)
  last_name varchar(50)
  phone varchar(15)
  relationship varchar(20)
}

Table TriageEntry {
  id int [pk, increment]
  patient_amka char(11)
  nurse_amka char(11)
  arrival_time timestamp
  service_time timestamp [null]
  urgency_level int
  symptoms text
  referral_status varchar(20)
  hosp_id int [null]
}

Table ICD10_Ref {
  code varchar(10) [pk]
  description text
}

Table KEN_Ref {
  code varchar(10) [pk]
  base_cost decimal(10,2)
  mdn_days int 
}

Table Hospitalization {
  id int [pk, increment]
  patient_amka char(11)
  bed_number int
  dep_id int
  entry_date date
  exit_date date
  icd10_entry_code varchar(10)
  icd10_exit_code varchar(10)
  ken_code varchar(10)
  total_cost decimal(10,2)
}

Table LabExam {
  id int [pk, increment]
  hosp_id int [not null]
  doctor_amka char(11) [not null]
  code varchar(20) [not null]
  type varchar(50) [not null]
  exam_date date [not null]
  result text
  cost decimal(10,2)
}

Table MedicalAct {
  id int [pk, increment]
  hosp_id int [not null]
  name varchar(100)
  category varchar(50)
  duration_minutes int [not null]
  cost decimal(10,2)
  main_surgeon_amka char(11) [not null]
  room_id int [not null]
  scheduled_time timestamp [not null]
}

Table OperatingRoom {
  id int [pk, increment]
  name varchar(50)
  type varchar(30)
}

Table ActDoctor {
  act_id int
  doctor_amka char(11)
  primary key (act_id, doctor_amka)
}

Table ActNurse {
  act_id int
  nurse_amka char(11)
  primary key (act_id, nurse_amka)
}

Table Medication {
  id int [pk]
  product_name varchar(100)
}

Table ActiveSubstance {
  id int [pk]
  substance_name varchar(100)
  medication_id int
}

Table Allergy {
  id int [pk]
  patient_amka char(11) [pk]
  substance_id int [pk]
}

Table Prescription {
  doctor_amka char(11)
  patient_amka char(11)
  medication_id int
  hosp_id int
  start_date date
  dosage varchar(50)
  frequency varchar(50)
  end_date date
  primary key (doctor_amka, patient_amka, medication_id, start_date)
}

Table Rating {
  hosp_id int [pk]
  rating_id int [pk]
  medical_care_quality int
  nursing_care_quality int
  cleanliness int
  food int
  overall_experience int
}

Table Image {
  image_id int [pk]
  description text
  image_url varchar(255)
}

Ref: Doctor.amka - Staff.amka
Ref: Nurse.amka - Staff.amka
Ref: Admin.amka - Staff.amka
Ref: Doctor.image_id > Image.image_id
Ref: Doctor.supervisor_amka > Doctor.amka

Ref: Department.director_amka > Doctor.amka
Ref: Bed.dep_id > Department.id
Ref: Nurse.dep_id > Department.id
Ref: Admin.dep_id > Department.id
Ref: Department.image_id > Image.image_id

Ref: DoctorDepartment.doctor_amka > Doctor.amka
Ref: DoctorDepartment.dep_id > Department.id

Ref: ShiftAssignment.staff_amka > Staff.amka
Ref: ShiftAssignment.shift_id > Shift.id
Ref: ShiftAssignment.dep_id > Department.id

Ref: EmergencyContact.patient_amka > Patient.amka

Ref: TriageEntry.patient_amka > Patient.amka
Ref: TriageEntry.nurse_amka > Nurse.amka
Ref: TriageEntry.hosp_id - Hospitalization.id
Ref: Hospitalization.patient_amka > Patient.amka
Ref: Hospitalization.(bed_number, dep_id) > Bed.(bed_number, dep_id)

Ref: Hospitalization.icd10_entry_code > ICD10_Ref.code
Ref: Hospitalization.icd10_exit_code > ICD10_Ref.code
Ref: Hospitalization.ken_code > KEN_Ref.code

Ref: LabExam.hosp_id > Hospitalization.id
Ref: LabExam.doctor_amka > Doctor.amka

Ref: MedicalAct.hosp_id > Hospitalization.id
Ref: MedicalAct.main_surgeon_amka > Doctor.amka
Ref: MedicalAct.room_id > OperatingRoom.id

Ref: ActDoctor.act_id > MedicalAct.id
Ref: ActDoctor.doctor_amka > Doctor.amka
Ref: ActNurse.act_id > MedicalAct.id
Ref: ActNurse.nurse_amka > Nurse.amka

Ref: ActiveSubstance.medication_id > Medication.id
Ref: Allergy.patient_amka > Patient.amka
Ref: Allergy.substance_id > ActiveSubstance.id
Ref: Prescription.medication_id > Medication.id
Ref: Prescription.patient_amka > Patient.amka
Ref: Prescription.doctor_amka > Doctor.amka
Ref: Prescription.hosp_id > Hospitalization.id

Ref: Rating.hosp_id - Hospitalization.id

